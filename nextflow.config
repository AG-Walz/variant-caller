/*
 * nextflow.config — resource override to optimize runtime and avoid errors
 * finetuned for the local machine peptimine_highmem1 (28 cores, 503 GB, Docker only). 
 * Passed to the sarek clone with `-c`. 
 */

// Cap the SUM across concurrently running tasks, reducing from all available processors
// 28-core to 26 as well as reducing from total system memory of 503 down to 480 GB. 
// This reduction leaves enough space for the Java process, Docker daemon and OS.
executor {
    cpus   = 26
    memory = '480 GB'
}

process {
    // Raise Picard MarkDuplicates memory from 30 GB to 60 GB to avoid heap spilling to 
    // --TMP_DIR when holding its duplicate set
    withName: 'GATK4_MARKDUPLICATES|GATK4SPARK_MARKDUPLICATES' {
        cpus   = 6
        memory = { 60.GB * task.attempt }
    }

    // Raise the number of cpus from 2 to 4 & memory from 12 to 16 GB for the Mutect2 task
    withName: 'GATK4_MUTECT2' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
    }

    // Memory scales with `task.attempt` because base.config retries exit 137 once; a static
    // literal would make the retry ask for the same memory and fail identically. `cpus` is
    // static on purpose — it is the concurrency budget above, not a per-task appetite.
}

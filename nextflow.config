/*
 * nextflow.config — resource overrides for peptimine_highmem1 (28 cores, 503 GB, Docker only).
 * Passed to the sarek clone with `-c`. Resources ONLY: no params, no container engine
 * (that is `-profile docker` on the CLI), so the clone stays provably stock 3.9.0.
 *
 * Two blocks were DELETED after measuring what the pilot's tasks actually used:
 *   FASTP        was given 16 GB, used 1.4 GB peak (and only 822-933% of 16 cpus)
 *   BWAMEM1_MEM  was given 120 GB, used 10.9 GB peak (base.config's 24 cpus was already right)
 * Neither did anything except make the config look considered.
 *
 * One consequence, because it costs 16 h if it surprises you: dropping the FASTP block returns
 * it to base.config's 12 cpus, and fastp's command line contains `--thread $task.cpus`. The
 * command line IS part of the task hash, so `-resume` against a work dir produced with the old
 * 16-cpu block MISSES on FASTP and re-runs everything downstream of it. Memory-only changes
 * (and the MARKDUPLICATES/MUTECT2 blocks below, whose modules never interpolate task.cpus) are
 * cache-safe; changing cpus on a process that threads by task.cpus is not.
 */

// Bound the LOCAL executor's total concurrency (no queue manager here). This is NOT the
// same mechanism as process.resourceLimits: this caps the SUM across running tasks,
// resourceLimits caps ONE task and can only clamp DOWNWARD — it would silently revert
// both overrides below. Headroom is for the JVM, the docker daemon and the OS.
// Proven applied: the run's log records "local task monitor ... cpus=26; memory=480 GB".
executor {
    cpus   = 26
    memory = '480 GB'
}

process {
    // Picard MarkDuplicates holds its duplicate set in heap and spills to --TMP_DIR when
    // it cannot. Measured peak RSS 42.5 / 42.6 GB against base.config's 30 GB ceiling.
    // Caveat worth knowing: sarek sets -Xmx to 0.8 x task.memory, so that peak is partly
    // heap filling the space we granted; at 30 GB it would spill rather than fail.
    withName: 'GATK4_MARKDUPLICATES|GATK4SPARK_MARKDUPLICATES' {
        cpus   = 6
        memory = { 60.GB * task.attempt }
    }

    // 83 Mutect2 shards under a 26-cpu cap: per-shard `cpus` IS the concurrency knob
    // (26/4 = 6 concurrent shards). Measured 262% CPU, so 4 is earned; measured 2.8 GB
    // peak RSS, so 16 GB is generous but harmless. Note this process is `process_low`,
    // not process_medium — this block RAISES it.
    withName: 'GATK4_MUTECT2' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
    }

    // `{ N * task.attempt }` above is not decoration: base.config scales its own requests
    // by attempt, and writing static literals silently removed retry escalation, so an
    // OOM (exit 137, which base.config retries once) was guaranteed to fail identically.
}

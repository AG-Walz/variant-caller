/*
 * variant-caller v1 — resource override for peptimine_highmem1
 * ------------------------------------------------------------------
 * Passed to the wrapped nf-core/sarek clone via `-c nextflow.config`.
 * This file ONLY tunes process resources for the target box:
 *   peptimine_highmem1 = 28 cores, 503 GB RAM, Docker-only.
 *
 * It deliberately does NOT:
 *   - set a container engine   (that comes from `-profile docker` on the CLI)
 *   - redefine any pipeline params (those are pinned on the CLI in run_pilot.sh)
 * Every block below is an override of a sarek conf/base.config default.
 */

// Global executor cap: the pilot runs under the `local` executor (plain bash,
// no SLURM). Bound total concurrent CPU/RAM so Nextflow packs many small
// scattered tasks onto the box without oversubscribing 28 cores / 503 GB.
// We hold back a few cores and ~23 GB for the JVM, Docker daemon and OS.
executor {
    cpus   = 26
    memory = '480 GB'
}

process {

    // Alignment is the throughput bottleneck for WES FASTQ input.
    // Give bwa-mem2 (the sarek 3.9 default aligner; BWAMEM1 covered for safety)
    // a large slice: 24 threads + 120 GB (bwa-mem2 index load is memory-heavy).
    // Overrides base.config's 24 cpus / 30 GB.
    withName: 'BWAMEM1_MEM|BWAMEM2_MEM' {
        cpus   = 24
        memory = '120 GB'
    }

    // fastp does the NextSeq poly-G trim (--trim_nextseq). CPU-bound; base.config
    // gives it 12 cpus / 4 GB — widen threads and RAM so it is not the long pole.
    withName: 'FASTP' {
        cpus   = 16
        memory = '16 GB'
    }

    // MarkDuplicates on a full WES BAM is memory-sensitive (sort spill).
    // Base.config gives 6 cpus / 30 GB; lift RAM to reduce disk spill.
    withName: 'GATK4_MARKDUPLICATES|GATK4SPARK_MARKDUPLICATES' {
        cpus   = 6
        memory = '60 GB'
    }

    // Mutect2 is scattered per interval (many short tasks). Base.config has no
    // explicit entry, so it inherits process_medium (6 cpus / 36 GB) — trim it
    // to 4 cpus / 16 GB so more shards run concurrently under the executor cap.
    withName: 'GATK4_MUTECT2' {
        cpus   = 4
        memory = '16 GB'
    }
}
